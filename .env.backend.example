# ============================================
# NGU Backend - Production Environment File
# ============================================
# Copy to .env.backend on your EC2 instance
# Set permissions: chmod 600 .env.backend
# NEVER commit this file to git!

# ============================================
# Security
# ============================================
DEBUG=False

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-50-character-random-secret-key

# ============================================
# Domain Configuration
# ============================================
# Comma-separated list of allowed hosts
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com,www.yourdomain.com

# CORS - Frontend domains allowed to make requests
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com,https://www.yourdomain.com
CORS_ALLOW_ALL_ORIGINS=False

# CSRF - Domains trusted for admin/form submissions
CSRF_TRUSTED_ORIGINS=https://api.yourdomain.com,https://admin.yourdomain.com

# ============================================
# Database (AWS RDS PostgreSQL)
# ============================================
DB_ENGINE=django.db.backends.postgresql
DB_NAME=ngu_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432

# ============================================
# AWS S3 Storage
# ============================================
USE_S3=True
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=your-s3-bucket-name
AWS_S3_REGION_NAME=ap-south-1

# ============================================
# Payment Gateway (Razorpay)
# ============================================
# Flip RAZORPAY_TEST_MODE to switch modes, then restart backend + scheduler.
RAZORPAY_TEST_MODE=False

RAZORPAY_TEST_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_TEST_KEY_SECRET=your-razorpay-test-secret
RAZORPAY_TEST_WEBHOOK_SECRET=

RAZORPAY_LIVE_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_LIVE_KEY_SECRET=your-razorpay-live-secret
RAZORPAY_LIVE_WEBHOOK_SECRET=

# ============================================
# Pricing / Checkout
# ============================================
SHIPPING_CHARGE=69
FREE_SHIPPING_THRESHOLD=499
DEFAULT_TAX_RATE=5

# ============================================
# AI Features (Perplexity)
# ============================================
PERPLEXITY_API_KEY=your-perplexity-api-key
LLM_API_KEY=your-llm-api-key
MODEL_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini
ASSISTANT_MODEL_PROVIDER=openrouter
ASSISTANT_LLM_MODEL=openai/gpt-4o-mini
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_CHAT_COMPLETIONS_URL=https://openrouter.ai/api/v1/chat/completions
ASSISTANT_MODEL_CONTEXT_TOKENS=12000
ASSISTANT_MAX_OUTPUT_TOKENS=1000
ASSISTANT_TOOL_OBS_RESERVE_TOKENS=4000
ASSISTANT_MAX_HISTORY_MESSAGES=500

# ============================================
# Analytics / Geocoding
# ============================================
ANALYTICS_MAX_BATCH=50
NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse
NOMINATIM_USER_AGENT=NidhiMasala/1.0 (nidhimasala.com)

# ============================================
# Invoice Seller Details
# ============================================
SELLER_NAME=Nidhi Grah Udyog
SELLER_PROPRIETOR=Lalit Kumar Jain
SELLER_TAGLINE=Pure & Authentic Indian Spices
SELLER_ADDRESS=7, Industrial Area, Runija Road,<br/>Barnagar, Ujjain, Madhya Pradesh 456771
SELLER_GSTIN=23ABUPJ8925C1ZI
SELLER_FSSAI=11414730000288
SELLER_STATE=Madhya Pradesh
SELLER_STATE_CODE=23
SELLER_EMAIL=nidhispicesandfood@gmail.com
SELLER_PHONE=+91 93000 05040

# ============================================
# Email Configuration (Optional)
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
