# ============================================
# NGU E-commerce Platform - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================
# Django Settings
# ============================================
SECRET_KEY=your-super-secret-key-here-make-it-long-and-random
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# ============================================
# Database (RDS PostgreSQL)
# ============================================
DB_ENGINE=django.db.backends.postgresql
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=5432

# ============================================
# Cloudinary CDN (media / images)
# ============================================
# Preferred backend for product/category/profile images. Serves from Cloudinary's
# global image CDN. Takes precedence over USE_S3 for media files.
USE_CLOUDINARY=True
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ============================================
# AWS S3 Storage (static files + legacy media)
# ============================================
USE_S3=True
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=ap-south-1

# ============================================
# Redis Cache (Docker will set this automatically)
# ============================================
# For local development without Docker, leave empty
# For Docker: redis://redis:6379/0
REDIS_URL=

# ============================================
# Payment Gateway (Razorpay)
# ============================================
# RAZORPAY_TEST_MODE selects which key pair below is active. True = test keys.
# The boot guard rejects a mismatch (test mode + rzp_live_ key, or vice versa)
# and refuses live keys entirely while DEBUG=True.
RAZORPAY_TEST_MODE=True

RAZORPAY_TEST_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_TEST_KEY_SECRET=your-razorpay-test-secret
RAZORPAY_TEST_WEBHOOK_SECRET=

RAZORPAY_LIVE_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_LIVE_KEY_SECRET=your-razorpay-live-secret
RAZORPAY_LIVE_WEBHOOK_SECRET=

# ============================================
# Pricing / Checkout
# ============================================
SHIPPING_CHARGE=69
FREE_SHIPPING_THRESHOLD=499
DEFAULT_TAX_RATE=5

# ============================================
# Email Configuration (Optional)
# ============================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# ============================================
# API Keys (Optional)
# ============================================
PERPLEXITY_API_KEY=your-perplexity-api-key

# ---- LLM (search synonyms + AI shopping assistant) ----
# Shared API key used by both the search engine and the AI assistant.
LLM_API_KEY=your-llm-api-key
# Provider + model used by the search synonym generator.
MODEL_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini
# Optional overrides so the assistant can use a stronger chat model than search.
# If unset, the assistant falls back to MODEL_PROVIDER / LLM_MODEL above.
ASSISTANT_MODEL_PROVIDER=openrouter
ASSISTANT_LLM_MODEL=openai/gpt-4o-mini
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_CHAT_COMPLETIONS_URL=https://openrouter.ai/api/v1/chat/completions
ASSISTANT_MODEL_CONTEXT_TOKENS=200000
ASSISTANT_MAX_OUTPUT_TOKENS=600
ASSISTANT_TOOL_OBS_RESERVE_TOKENS=8000
ASSISTANT_MAX_HISTORY_MESSAGES=500

# ============================================
# Analytics / Geocoding
# ============================================
ANALYTICS_MAX_BATCH=50
NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse
NOMINATIM_USER_AGENT=NidhiMasala/1.0 (nidhimasala.com)

# ============================================
# Invoice Seller Details
# ============================================
SELLER_NAME=Nidhi Grah Udyog
SELLER_PROPRIETOR=Lalit Kumar Jain
SELLER_TAGLINE=Pure & Authentic Indian Spices
SELLER_ADDRESS=7, Industrial Area, Runija Road,<br/>Barnagar, Ujjain, Madhya Pradesh 456771
SELLER_GSTIN=23ABUPJ8925C1ZI
SELLER_FSSAI=11414730000288
SELLER_STATE=Madhya Pradesh
SELLER_STATE_CODE=23
SELLER_EMAIL=nidhispicesandfood@gmail.com
SELLER_PHONE=+91 93000 05040

# ============================================
# CORS (Frontend URLs)
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://your-domain.com
